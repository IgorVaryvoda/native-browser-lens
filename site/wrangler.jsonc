{
  // lens.sirv.studio: a static site, served by Workers static assets. `node site/deploy.mjs`
  // assembles dist/ (pages plus the installers and their manifest) and deploys it.
  "name": "sirv-lens-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "lens.sirv.studio", "custom_domain": true }]
}
